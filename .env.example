# Intelligent Border Video Analytics Platform Configuration
PROJECT_NAME="Intelligent Border Video Analytics Platform"
SECRET_KEY="border-security-secret-key-super-secure-2026"

# ---------------------------------------------------------------------------
# Database Connection
#   Local (easy run):  sqlite:///./border_analytics.db
#   Supabase:  postgresql://postgres.<REF>.<USER>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
#              (copy the "Pooler / Transaction" URI from Supabase > Settings > Database)
# ---------------------------------------------------------------------------
DATABASE_URL="sqlite:///./border_analytics.db"

# ---------------------------------------------------------------------------
# Supabase platform (optional - the app runs fine without these)
#   SUPABASE_URL                https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY   Settings > API > service_role key  (server-side only)
#   SUPABASE_JWT_SECRET         Settings > API > JWT secret  (for verifying Supabase Auth tokens)
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
USE_SUPABASE_AUTH=false

# ---------------------------------------------------------------------------
# Dataset seeding (controls how much real data is pulled)
#
#   Run `python scripts/download_datasets.py` (from backend/) to fetch sources:
#     - VIRAT Ground annotations  -> data_cache/virat/annotations/*.txt  (~40 MB zip)
#     - MOT17 labels              -> data_cache/mot17/MOT17Labels.zip   (~140 MB zip)
#
#   Then run `python -m app.data.seed` to import them into the database.
# ---------------------------------------------------------------------------
DATA_CACHE_DIR="./data_cache"
# Max number of VIRAT clips (each becomes a VIRAT-XXXXXX camera) to import
DATASET_VIRAT_MAX_CLIPS=3
# Max number of MOT17 sequences (each becomes a MOT17-XX camera) to import
DATASET_MOT17_SEQUENCES=3
# Down-sample annotations: keep 1 detection every N source frames
DATASET_FRAME_SAMPLE=15

DEMO_MODE=True
SIMULATION_INTERVAL_SEC=1.5